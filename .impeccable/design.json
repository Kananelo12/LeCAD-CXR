  "narrative": {
    "northStar": "The Viewing Station",
    "overview": "The chest film is the exhibit. Every working screen sets the X-ray, or the place it will go, on a centre stage, with the evidence panel beside it, the way a reporting station puts the film first and the notes second. The system stays quiet so the radiograph and the model's evidence carry the screen: a cool, light ground, white panels, and one clinical blue spent only where a clinician acts or chooses.\n\nIt is a light-only system (a user decision, recorded in PRODUCT.md) for clinicians at a laptop or desktop in daylight or office light, sometimes on a projector. Familiarity beats flourish: standard controls, one workhorse sans, and colour that always means something.",
    "keyCharacteristics": [
      "The film sits on a near-black stage inside a white panel; nothing ever covers the image.",
      "60-30-10: cool pale ground, white panels, clinical blue for action, current tab, selection and focus.",
      "Graded evidence is never colour alone: every band has an icon and words.",
      "One elevation, one family, one corner system."
    ],
    "rules": [
      {
        "name": "The Ten Percent Rule",
        "body": "Blue marks only something the clinician can do, has chosen, or is focused on. Section icons, bullets, avatars and decoration stay neutral; if removing the blue would not change what the user can do or knows, it should not be blue.",
        "section": "colors"
      },
      {
        "name": "The No Red/Green Rule",
        "body": "Bands avoid red and green. \"Flagged\" is a prompt to look, not a diagnosis, and must never read as an alarm or an all-clear.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "No display face, no serif. Hierarchy comes from size and weight steps of the same family.",
        "section": "typography"
      },
      {
        "name": "The Measured Numbers Rule",
        "body": "Every number that is compared or copied uses tabular figures.",
        "section": "typography"
      },
      {
        "name": "The One Lift Rule",
        "body": "Only the current selection rises above a panel. If two things inside a panel are raised, one of them is wrong.",
        "section": "elevation"
      },
      {
        "name": "The Radius Ladder Rule",
        "body": "Panels 16px; rows, inputs and the film inset 10px; badges 6px; controls (buttons, tabs, the toolbar, the user chip) full pill. A shape tells you what something is: pills are pressed, 16px holds content, 10px sits inside it.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do let the film carry the screen; keep everything around it neutral.",
      "Do pair every state colour with an icon and words.",
      "Do spend blue only on action, selection, current location and focus.",
      "Do keep the toolbar and any overlay clear of the image edges, where the lung bases and costophrenic angles sit.",
      "Do theme browser surfaces (selection, caret, scrollbar, focus) from the palette."
    ],
    "donts": [
      "Don't add a dark theme or invert a section.",
      "Don't use red or green for findings.",
      "Don't put decorative anatomy art, invented logos or stock imagery on working screens; the uploaded film is the only image.",
      "Don't nest panels or give a panel both a border and a shadow.",
      "Don't use em dashes in interface copy."
    ]
  }
}
