# Copy to .env and edit. .env is gitignored — never commit it.

# Root of the ChestX-ray14 download.
# Windows (this laptop):  D:/Work/archive
# Kaggle notebook:        /kaggle/input/data
# Linux/macOS:            ~/data/chestxray14
LECAD_DATA_ROOT=D:/Work/archive

# Where training runs, checkpoints and reports are written (outside git).
LECAD_ARTIFACTS=./ml/artifacts

# Reproducibility. Change this and your splits change — don't.
LECAD_SEED=42

# Test-set lock. Leave this commented out. Uncommenting it here would unlock
# the test set for EVERY run. Set it for one command only, once, for the
# final evaluation (see docs/training-guide.md).
# LECAD_ALLOW_TEST=1

# ── API (later) ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://lecad:lecad@localhost:5432/lecad
JWT_SECRET=change-me-and-never-commit-the-real-one
MODEL_REPO=your-hf-username/lecad-cxr
MODEL_REVISION=main
