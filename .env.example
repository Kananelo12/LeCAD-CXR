# Copy to .env and edit. .env is gitignored — never commit it.

# Root of the ChestX-ray14 download.
# Windows (this laptop):  D:/Work/archive
# Kaggle notebook:        /kaggle/input/data
# Linux/macOS:            ~/data/chestxray14
LECAD_DATA_ROOT=D:/Work/archive

# Where training runs, checkpoints and reports are written (outside git).
LECAD_ARTIFACTS=./ml/artifacts

# Reproducibility. Change this and your splits change — don't.
LECAD_SEED=42

# Test-set lock. Leave this commented out. Uncommenting it here would unlock
# the test set for EVERY run. Set it for one command only, once, for the
# final evaluation (see docs/training-guide.md).
# LECAD_ALLOW_TEST=1

# ── API (docs/serving-guide.md) ──────────────────────────────────────────
# PostgreSQL in deployment, hosted on Neon (ADR 0004): use the direct
# (non-pooled) string from the Neon console, with postgresql:// changed to
# postgresql+psycopg:// (docs/serving-guide.md, step 2C).
# For a quick local run, SQLite also works:
#   DATABASE_URL=sqlite:///./ml/artifacts/lecad.db
DATABASE_URL=postgresql+psycopg://lecad:lecad@localhost:5432/lecad

# Signs session tokens. The API refuses to start with this placeholder.
# Generate a real one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-and-never-commit-the-real-one

# Exactly one of these two. The deployed model ships with the repository; a
# relative path is read from the repository root. The fake model gives
# random results (and says so) for frontend work without PyTorch loading.
LECAD_MODEL_PATH=ml/models/model_sens90.pt
# LECAD_FAKE_MODEL=1

# 0 only for local development over plain http. Leave unset (secure) for
# anything served over https.
LECAD_COOKIE_SECURE=0
